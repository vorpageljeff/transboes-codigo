API_DOMAIN=api.transboes.exemplo.com.br
LETSENCRYPT_EMAIL=infra@exemplo.com.br
POSTGRES_DB=transboes
POSTGRES_USER=transboes_app
POSTGRES_PASSWORD=gere-uma-senha-forte
JWT_SECRET=gere-uma-chave-aleatoria-com-no-minimo-32-caracteres
CORS_ORIGINS=https://transboes.exemplo.com.br
AUTO_ASSIGN_TRIP=false
AUTO_RELEASE_VEHICLE=true
FREIGHT_VALIDATION_MODE=MOCK
GPS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PREPARATION_MINUTES=40
VEHICLE_RELEASE_RULE=AFTER_UNLOAD
MAINTENANCE_ALERT_KM=1000
MAINTENANCE_ALERT_DAYS=15
APP_IMAGE=transboes-api:local
BACKUP_DIR=/opt/innovagro/backups/transboes

# Papéis separados: runtime sem privilégios de administração; migrations com proprietário.
APP_DATABASE_URL=postgresql+psycopg://transboes_runtime:CHANGE_ME@db:5432/transboes
MIGRATION_DATABASE_URL=postgresql+psycopg://transboes_app:CHANGE_ME@db:5432/transboes
